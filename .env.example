# UniFi Controller
UNIFI_URL=https://192.168.1.1          # Controller URL (UDM, UDM-Pro, or self-hosted)
UNIFI_SITE=default                      # Site name (default is usually correct)
UNIFI_INSECURE=false                    # Set true to skip TLS verification (self-signed certs)
# Authentication — use API key (recommended, UniFi OS only) OR username+password
UNIFI_API_KEY=                          # Settings → Control Plane → API Keys (UniFi OS 3.2+)
UNIFI_USERNAME=admin                    # Local admin account (if not using API key)
UNIFI_PASSWORD=changeme                 # (if not using API key)

# Uptime Kuma
# Kuma has no REST API for managing monitors (only Socket.IO, like the web UI),
# and no API-key auth for that — so username+password (the same login you use
# in the Kuma UI) or KUMA_DISABLE_AUTH are the only options.
KUMA_URL=http://uptime-kuma:3001
KUMA_USERNAME=admin                     # (not needed if KUMA_DISABLE_AUTH=true)
KUMA_PASSWORD=changeme                  # (not needed if KUMA_DISABLE_AUTH=true)
KUMA_DISABLE_AUTH=false                 # true if Kuma has "Disable Auth" enabled (Settings → Security)

# Sync behaviour
SYNC_TAG_PREFIX=kuma                    # Monitor any UniFi tag starting with "kuma-"
SYNC_INTERVAL_SECONDS=300               # How often to sync (seconds)
SYNC_DRY_RUN=false                      # Log planned actions without making changes
SYNC_DELETE_ORPHAN=false                # Delete Kuma monitors with no matching UniFi device
