# UniFi Controller
UNIFI_URL=https://192.168.1.1          # Controller URL (UDM, UDM-Pro, or self-hosted)
UNIFI_SITE=default                      # Site name (default is usually correct)
UNIFI_INSECURE=false                    # Set true to skip TLS verification (self-signed certs)
# UniFi API keys only work against its newer public Integrations API, which
# doesn't expose Groups — so username+password (the same session-based auth
# the web UI uses) is the only option. Use a scoped-down local user, not your
# main admin login — see "Creating a read-only UniFi user" in README.md.
UNIFI_USERNAME=unifi-kuma
UNIFI_PASSWORD=changeme

# Uptime Kuma
# Kuma has no REST API for managing monitors (only Socket.IO, like the web UI),
# and no API-key auth for that — so username+password (the same login you use
# in the Kuma UI) or KUMA_DISABLE_AUTH are the only options.
KUMA_URL=http://uptime-kuma:3001
KUMA_USERNAME=admin                     # (not needed if KUMA_DISABLE_AUTH=true)
KUMA_PASSWORD=changeme                  # (not needed if KUMA_DISABLE_AUTH=true)
KUMA_DISABLE_AUTH=false                 # true if Kuma has "Disable Auth" enabled (Settings → Security)

# Sync behaviour
SYNC_MONITOR_GROUP=monitor              # Name of the UniFi Group whose members should be monitored
SYNC_GROUP_PREFIX=kuma-group            # Other UniFi groups matching "<prefix>-<name>" (e.g. kuma-group-servers)
                                         # determine which Kuma group a monitor lands in; unprefixed groups
                                         # (used for firewall rules, VLANs, etc.) are ignored
SYNC_HUMANIZE_GROUP_NAMES=true          # Title-case Kuma group names (servers -> Servers); false keeps them raw
SYNC_TAG_OTHER_GROUPS=false             # Tag monitors with the device's other UniFi group names (beyond the
                                         # monitor-flag and prefix-matching groups), e.g. "apple"
# SYNC_OTHER_GROUPS_TAG_COLOR=purple    # Color for SYNC_TAG_OTHER_GROUPS tags: gray, red, orange, blue,
                                         # indigo, purple, or pink (matches Kuma's own tag color picker)
SYNC_INTERVAL_SECONDS=300               # How often to sync (seconds)
SYNC_DRY_RUN=false                      # Log planned actions without making changes
SYNC_DELETE_ORPHAN=false                # Delete Kuma monitors with no matching UniFi device
